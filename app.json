{
  "expo": {
    "name": "A Little Better",
    "slug": "a-little-better",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alittlebetter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kroniq.alittlebetter"
    },
    "android": {
      "package": "com.kroniq.alittlebetter",
      "adaptiveIcon": {
        "backgroundColor": "#EDE7DC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EDE7DC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1C1D1A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A8B3A0",
          "defaultChannel": "daily-reminder",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "DailyMessage",
              "displayName": "A Little Better",
              "description": "Today's message, at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
